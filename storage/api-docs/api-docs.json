{
    "openapi": "3.0.0",
    "info": {
        "title": "Atlas API",
        "description": "API documentation",
        "version": "1.0.0"
    },
    "paths": {
        "/api/v1/employees": {
            "get": {
                "tags": [
                    "Employees"
                ],
                "summary": "Get list of employees",
                "operationId": "2e641bdc699591310bf30f24fd740289",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/EmployeeName"
                    },
                    {
                        "$ref": "#/components/parameters/EmployeePosition"
                    },
                    {
                        "$ref": "#/components/parameters/EmployeeLeaveBalance"
                    },
                    {
                        "$ref": "#/components/parameters/EmployeeLeaveBalanceMax"
                    },
                    {
                        "$ref": "#/components/parameters/EmployeeLeaveBalanceMin"
                    },
                    {
                        "$ref": "#/components/parameters/Page"
                    },
                    {
                        "$ref": "#/components/parameters/PerPage"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/EmployeeResource"
                                            }
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/MetaPagination"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/leave-requests": {
            "post": {
                "tags": [
                    "Leave Requests"
                ],
                "summary": "Create a new leave request",
                "description": "Submit a new leave request. The system will validate business rules and may create as PENDING_HR or DRAFT status.",
                "operationId": "f05037087fbf0b40b0c238b833955a60",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/StoreLeaveRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Leave request created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/LeaveRequestResource"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Request rejected due to business rules",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "حداقل 3 روز از آخرین درخواست مرخصی نگذشته است."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "The given data was invalid."
                                        },
                                        "errors": {
                                            "properties": {
                                                "employee_id": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string",
                                                        "example": "The selected employee id is invalid."
                                                    }
                                                },
                                                "type": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string",
                                                        "example": "The selected type is invalid."
                                                    }
                                                },
                                                "start_date": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string",
                                                        "example": "The start date must be a date after or equal to today."
                                                    }
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "EmployeeResource": {
                "title": "Employee Resource",
                "description": "Employee data formatted for API responses",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "John Doe"
                    },
                    "position": {
                        "type": "string",
                        "example": "Software Engineer"
                    },
                    "leave_balance": {
                        "type": "integer",
                        "example": 14
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2024-01-01T12:00:00Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2024-01-05T09:30:00Z"
                    }
                },
                "type": "object"
            },
            "LeaveRequestResource": {
                "title": "Leave Request Resource",
                "description": "Leave request data formatted for API responses",
                "properties": {
                    "id": {
                        "description": "Leave request ID",
                        "type": "integer",
                        "example": 37
                    },
                    "employee_id": {
                        "description": "Employee ID",
                        "type": "integer",
                        "example": 5
                    },
                    "leave_type": {
                        "description": "Type of leave",
                        "type": "string",
                        "enum": [
                            "annual",
                            "sick",
                            "hourly",
                            "unpaid"
                        ],
                        "example": "annual"
                    },
                    "status": {
                        "description": "Current status of the leave request",
                        "type": "string",
                        "enum": [
                            "draft",
                            "pending_hr",
                            "pending_manager",
                            "pending_ceo",
                            "approved",
                            "rejected",
                            "due_date"
                        ],
                        "example": "draft"
                    },
                    "start_date": {
                        "description": "Start date in both formats",
                        "properties": {
                            "gregorian": {
                                "type": "string",
                                "format": "date",
                                "example": "2024-12-10"
                            },
                            "jalali": {
                                "type": "string",
                                "example": "1403/09/20"
                            }
                        },
                        "type": "object"
                    },
                    "end_date": {
                        "description": "End date in both formats (null for hourly leaves)",
                        "properties": {
                            "gregorian": {
                                "type": "string",
                                "format": "date",
                                "example": "2024-12-12"
                            },
                            "jalali": {
                                "type": "string",
                                "example": "1403/09/22"
                            }
                        },
                        "type": "object",
                        "nullable": true
                    },
                    "start_time": {
                        "description": "Start time (for hourly leaves only)",
                        "type": "string",
                        "format": "time",
                        "example": "09:00",
                        "nullable": true
                    },
                    "end_time": {
                        "description": "End time (for hourly leaves only)",
                        "type": "string",
                        "format": "time",
                        "example": "12:00",
                        "nullable": true
                    },
                    "days_count": {
                        "description": "Number of days (null for hourly leaves)",
                        "type": "integer",
                        "example": 3,
                        "nullable": true
                    },
                    "hours_count": {
                        "description": "Number of hours (null for daily leaves)",
                        "type": "number",
                        "format": "float",
                        "example": 3.5,
                        "nullable": true
                    },
                    "reason": {
                        "description": "Reason for the leave request",
                        "type": "string",
                        "example": "استراحت",
                        "nullable": true
                    },
                    "rejection_reason": {
                        "description": "Reason for rejection or draft status",
                        "type": "string",
                        "example": "محدودیت ماهانه مرخصی پر شده است",
                        "nullable": true
                    },
                    "message": {
                        "description": "Status message based on current status",
                        "type": "string",
                        "example": "درخواست مرخصی به عنوان پیش‌نویس ذخیره شد و نیاز به بررسی و تایید دارد."
                    }
                },
                "type": "object"
            },
            "StoreLeaveRequest": {
                "title": "Store Leave Request",
                "description": "Request body for creating a new leave request",
                "required": [
                    "employee_id",
                    "type",
                    "start_date"
                ],
                "properties": {
                    "employee_id": {
                        "description": "ID of the employee requesting leave",
                        "type": "integer",
                        "example": 5
                    },
                    "type": {
                        "description": "Type of leave request",
                        "type": "string",
                        "enum": [
                            "annual",
                            "sick",
                            "hourly",
                            "unpaid"
                        ],
                        "example": "annual"
                    },
                    "start_date": {
                        "description": "Start date in  Jalali (YYYY-MM-DD) format. Must be today or future date.",
                        "type": "string",
                        "format": "date",
                        "example": "1404-05-05"
                    },
                    "end_date": {
                        "description": "End date in  Jalali (YYYY-MM-DD) format (required for non-hourly leaves). Must be after start_date.",
                        "type": "string",
                        "format": "date",
                        "example": "1404-05-06"
                    },
                    "start_time": {
                        "description": "Start time (required for hourly leaves). Format: HH:MM",
                        "type": "string",
                        "format": "time",
                        "example": "09:00"
                    },
                    "end_time": {
                        "description": "End time (required for hourly leaves). Must be after start_time. Format: HH:MM",
                        "type": "string",
                        "format": "time",
                        "example": "12:00"
                    },
                    "reason": {
                        "description": "Reason for leave request (optional, max 1000 characters)",
                        "type": "string",
                        "example": "استراحت و مرخصی سالانه"
                    }
                },
                "type": "object"
            },
            "MetaPagination": {
                "properties": {
                    "current_page": {
                        "type": "integer"
                    },
                    "last_page": {
                        "type": "integer"
                    },
                    "per_page": {
                        "type": "integer"
                    },
                    "total": {
                        "type": "integer"
                    }
                },
                "type": "object"
            }
        },
        "parameters": {
            "EmployeeLeaveBalance": {
                "name": "leave_balance",
                "in": "query",
                "description": "Exact leave balance. Cannot be combined with min/max values.",
                "required": false,
                "schema": {
                    "type": "integer"
                }
            },
            "EmployeeLeaveBalanceMin": {
                "name": "leave_balance[min]",
                "in": "query",
                "description": "Minimum leave balance. Cannot be used with exact leave_balance.",
                "required": false,
                "schema": {
                    "type": "integer"
                }
            },
            "EmployeeLeaveBalanceMax": {
                "name": "leave_balance[max]",
                "in": "query",
                "description": "Maximum leave balance. Cannot be used with exact leave_balance. If both min and max are provided, min must not exceed max.",
                "required": false,
                "schema": {
                    "type": "integer"
                }
            },
            "EmployeeName": {
                "name": "name",
                "in": "query",
                "description": "Filter employees by exact name",
                "required": false,
                "schema": {
                    "type": "string"
                }
            },
            "EmployeePosition": {
                "name": "position",
                "in": "query",
                "description": "Filter employees by exact position",
                "required": false,
                "schema": {
                    "type": "string"
                }
            },
            "Page": {
                "name": "page",
                "in": "query",
                "description": "Page number",
                "required": false,
                "schema": {
                    "type": "integer",
                    "default": 1,
                    "minimum": 1
                }
            },
            "PerPage": {
                "name": "per_page",
                "in": "query",
                "description": "Number of items per page",
                "required": false,
                "schema": {
                    "type": "integer",
                    "default": 15,
                    "maximum": 100,
                    "minimum": 1
                }
            }
        }
    },
    "tags": [
        {
            "name": "Employees",
            "description": "Employees"
        },
        {
            "name": "Leave Requests",
            "description": "Leave Requests"
        }
    ]
}